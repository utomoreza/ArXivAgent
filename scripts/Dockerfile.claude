# docker build \
#   --build-arg UID=$(id -u) \
#   -f scripts/Dockerfile.claude \
#   -t claude-code-runner .

# docker run --rm -it \
#   --name arxivagent-dev \
#   -d \
#   -v "$(pwd)":/workspace \
#   --network arxivagent_network \
#   claude-code-runner bash


FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    git curl nodejs npm iputils-ping coreutils sudo tmux \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

RUN npm install -g @anthropic-ai/claude-code

ARG UID=1000
RUN useradd -m -u ${UID} -s /bin/bash claude

USER claude
WORKDIR /workspace

RUN git config --global user.email "claude@localhost" && \
    git config --global user.name "Claude Code"

# Entrypoint syncs the venv for Linux before handing off to claude.
# This overwrites any stale macOS .venv mounted from the host.
COPY --chown=claude scripts/entrypoint.sh /home/claude/entrypoint.sh
RUN chmod +x /home/claude/entrypoint.sh
ENTRYPOINT ["/home/claude/entrypoint.sh"]
