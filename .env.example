# ============================================================
# ArXiv Intelligence Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in required values:
#   cp .env.example .env

# ─── Required ───────────────────────────────────────────────

# Earliest date to backfill from on first run (ISO date, YYYY-MM-DD)
INCEPTION_DATE="2026-04-01"

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# PostgreSQL connection string (asyncpg driver required)
# Format: postgresql+asyncpg://user:pass@host[:port]/dbname
# User and password must be alphanumeric only
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/arxivagent"

# ─── Optional (defaults shown) ──────────────────────────────

# Number of days of digests to keep indexed for Q&A
# Digests outside this window are stored but not searchable via /qa
RAG_WINDOW_DAYS="90"

# Comma-separated arXiv categories to monitor
# Each must be in the form <lowercase-prefix>.<UPPERCASE-suffix> (e.g. cs.LG)
ARXIV_CATEGORIES="cs.LG,cs.CV,cs.CL,cs.AI,cs.RO,stat.ML"

# Comma-separated research topic labels used to group papers in digests
TOPIC_LIST="Large Language Models,Computer Vision,Reinforcement Learning,Multimodal AI,Robotics,ML Theory & Optimization"

# Cron expression for the daily digest job (runs in America/New_York timezone)
# Default: 20:30 ET, Sunday–Thursday
DAILY_SCHEDULER_TIME="30 20 * * 0,1,2,3,4"

# Cron expression for the weekly digest job (runs in America/New_York timezone)
# Default: 01:00 ET, Friday
WEEKLY_SCHEDULER_TIME="0 1 * * 5"

# Logging verbosity (DEBUG | INFO | ERROR)
LOG_LEVEL="INFO"
